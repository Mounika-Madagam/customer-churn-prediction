    "# --- XGBOOST WITH HYPERPARAMETER TUNING ---\n",
    "param_grid = {\n",
    "    'n_estimators': [100, 200],\n",
    "    'max_depth': [3, 5, 7],\n",
    "    'learning_rate': [0.01, 0.1]\n",
    "}\n",
    "\n",
    "xgb = XGBClassifier(random_state=42, eval_metric='logloss')\n",
    "grid_search = GridSearchCV(xgb, param_grid, cv=5, scoring='roc_auc', n_jobs=-1, verbose=1)\n",
    "\n",
    "print(\"Training XGBoost... please wait 1-3 minutes\")\n",
    "grid_search.fit(X_train, y_train)\n",
    "\n",
    "best_xgb = grid_search.best_estimator_\n",
    "xgb_pred = best_xgb.predict(X_test)\n",
    "xgb_proba = best_xgb.predict_proba(X_test)[:, 1]\n",
    "\n",
    "print(\"\\nXGBOOST RESULTS (TUNED)\")\n",
    "print(f\"Best parameters: {grid_search.best_params_}\")\n",
    "print(f\"Test Accuracy: {accuracy_score(y_test, xgb_pred):.3f}\")\n",
